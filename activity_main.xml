<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍱 Mess Management"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your daily mess activities"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Menu"/>

        <Button
            android:id="@+id/btnAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mess Attendance"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Give Feedback"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnComplaint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report a Complaint"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnFees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mess Fees"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome! Select an option above."
            android:textSize="16sp"
            android:paddingTop="24dp"/>
    </LinearLayout>
</ScrollView>
